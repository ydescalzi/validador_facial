# Copia este archivo como .env y ajusta los valores.

ENVIRONMENT=development

# PERSIST=false → SIN base de datos y SIN guardar nada (todo en memoria; se borra al apagar).
# PERSIST=true  → usa DATABASE_URL (MySQL) y guarda las fotos aprobadas en storage/.
PERSIST=false

# Base de datos (solo con PERSIST=true). Para MySQL, crea la base y quita el #:
#   CREATE DATABASE photo_validator CHARACTER SET utf8mb4;
# DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/photo_validator?charset=utf8mb4

# Claves para que tu plataforma (Laravel, Node...) llame a la API. Separa varias con coma.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=pon-aqui-una-clave-larga-y-aleatoria

# Administrador del panel (/admin)
JWT_SECRET=pon-aqui-otra-clave-larga-y-aleatoria-de-32-caracteres-o-mas
ADMIN_USERNAME=admin
# Genera el hash con:  python -m app.core.security "TuContraseña"
ADMIN_PASSWORD_HASH=

# Orígenes que pueden llamar a la API desde el navegador
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# true: los estudiantes pueden subir desde la página de este servicio sin API key.
# false (recomendado en producción): solo tu plataforma, con API key, desde su backend.
PUBLIC_UI=true
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=5

# Retención de imágenes (días). 0 en aprobadas = no borrar automáticamente.
STORE_REJECTED=false
RETENTION_REVIEW_DAYS=30
RETENTION_APPROVED_DAYS=0

# Modelos
DEVICE=auto
ENABLE_YOLOS=true
ENABLE_FASHIONCLIP=true
ENABLE_MEDIAPIPE=true
# SegFormer tiene licencia "other": revísala antes de activarlo
ENABLE_SEGFORMER=false
# Después de descargar los modelos, puedes trabajar sin internet:
# HF_HUB_OFFLINE=1
